 kf6-knotifications-devel kf6-modemmanager-qt-devel kf6-networkmanager-qt-devel
 kf6-kcmutils-devel kf6-kpackage-devel kf6-kjobwidgets-devel
 kf6-kwindowsystem-devel kf6-kauth-devel kf6-kirigami-devel kf6-kdeclarative-devel
 kf6-kwayland-devel kf6-kcoreaddons-devel kf6-bluez-qt-devel
